# =============================================================================
# PAZOS — variables de entorno
# Desarrollo: ./scripts/bootstrap-env.sh copia este archivo a .env con secretos
# aleatorios. En staging/producción estos valores vienen del gestor de secretos;
# nunca se versionan.
# =============================================================================

# --- Base de datos (docker compose) -------------------------------------------
PAZ_DB_NAME=paz
# Rol dueño: ejecuta migraciones (Alembic) y el mantenimiento de la bitácora.
PAZ_DB_OWNER_USER=paz_owner
PAZ_DB_OWNER_PASSWORD=change-me
# Rol de la aplicación: mínimo privilegio, solo recibe los GRANT de las migraciones.
PAZ_DB_APP_USER=paz_app
PAZ_DB_APP_PASSWORD=change-me

# --- Cifrado a nivel aplicación (D-31, D-32) ----------------------------------
# Llaves maestras (KEK) versionadas: "versión:base64(32 bytes)", separadas por coma.
# Rotar = agregar "2:<nueva>" y cambiar la versión activa; las versiones viejas
# deben permanecer hasta re-envolver los datos (FieldCipher.rewrap).
# Generar una llave: uv run paz keys generate   (o: openssl rand -base64 32)
PAZ_ENCRYPTION_KEYS=1:change-me
PAZ_ENCRYPTION_ACTIVE_KEY_VERSION=1
# Llave HMAC para índices ciegos (CURP, teléfonos). Cambiarla obliga a recalcularlos.
PAZ_BLIND_INDEX_KEY=change-me

# --- Autenticación (D-48) -------------------------------------------------------
# Secreto HMAC para firmar los access tokens (JWT HS256). Mínimo 32 bytes aleatorios.
# Cambiarlo invalida todos los access tokens vigentes (las sesiones se renuevan con refresh).
PAZ_JWT_SECRET=change-me

# --- Puertos publicados en el host (docker compose) -----------------------------
# Cámbialos si ya tienes servicios locales en esos puertos (p. ej. un Redis propio).
# PAZ_DB_HOST_PORT=5432
# PAZ_REDIS_HOST_PORT=6379
# PAZ_API_HOST_PORT=8000
# PAZ_FRONTEND_HOST_PORT=5173
# PAZ_MAILPIT_UI_HOST_PORT=8025
# PAZ_MAILPIT_SMTP_HOST_PORT=1025
# PAZ_HTTP_HOST_PORT=80
# PAZ_HTTPS_HOST_PORT=443

# --- Aplicación ----------------------------------------------------------------
# PAZ_LOG_LEVEL=INFO
# Exportador OTLP/HTTP de trazas y métricas (vacío = no se exporta).
# PAZ_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Panel (frontend) -----------------------------------------------------------
# Mapa base del visor (D-72). Por defecto OpenFreeMap (sin llave). Se lee al construir el
# panel; si cambias de proveedor, ajusta también PAZ_MAP_TILES_ORIGIN (CSP de producción).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# PAZ_MAP_TILES_ORIGIN=https://tiles.openfreemap.org

# --- Referencia: variables que lee el backend ------------------------------------
# Compose las construye a partir de las anteriores; fuera de compose (p. ej. correr
# uvicorn o pytest en el host) se definen directamente:
#
# PAZ_ENVIRONMENT=development            development | test | staging | production
# PAZ_API_DOCS_ENABLED=true              Swagger UI (/docs), ReDoc (/redoc), /openapi.json
# PAZ_CORS_ALLOWED_ORIGINS=https://localhost   orígenes permitidos, separados por coma
# PAZ_DATABASE_URL=postgresql://paz_app:***@localhost:5432/paz
# PAZ_MIGRATIONS_DATABASE_URL=postgresql://paz_owner:***@localhost:5432/paz
# PAZ_DATABASE_APP_ROLE=paz_app          rol que reciben los GRANT en las migraciones
# PAZ_DATABASE_POOL_SIZE=10
# PAZ_DATABASE_MAX_OVERFLOW=10
# PAZ_DATABASE_STATEMENT_TIMEOUT_MS=15000
# PAZ_REDIS_URL=redis://localhost:6379/0
# PAZ_PUBLIC_BASE_URL=https://localhost  URL del panel para los enlaces de los correos
#
# Autenticación (valores por defecto):
# PAZ_ACCESS_TOKEN_TTL_SECONDS=900       vida del access token
# PAZ_REFRESH_TOKEN_TTL_SECONDS=604800   inactividad máxima de una sesión (7 días)
# PAZ_SESSION_ABSOLUTE_TTL_SECONDS=2592000  vida máxima de una sesión (30 días)
# PAZ_REFRESH_COOKIE_SECURE=true
# PAZ_INVITATION_TTL_SECONDS=259200      72 h
# PAZ_PASSWORD_RESET_TTL_SECONDS=1800    30 min
# PAZ_PASSWORD_MIN_LENGTH=12
# PAZ_MAX_FAILED_LOGINS=5                intentos antes de bloquear
# PAZ_LOCKOUT_SECONDS=900
# PAZ_LOGIN_RATE_LIMIT_PER_IP=20         por ventana de PAZ_LOGIN_RATE_LIMIT_WINDOW_SECONDS
# PAZ_ARGON2_TIME_COST=3 · PAZ_ARGON2_MEMORY_COST_KIB=65536 · PAZ_ARGON2_PARALLELISM=4
# PAZ_TOTP_ISSUER=PAZOS                  nombre que muestra la app autenticadora
#
# Correo:
# PAZ_MAIL_BACKEND=smtp                  smtp | console | memory
# PAZ_SMTP_HOST=localhost · PAZ_SMTP_PORT=1025 · PAZ_SMTP_USERNAME= · PAZ_SMTP_PASSWORD=
# PAZ_SMTP_STARTTLS=false · PAZ_SMTP_USE_TLS=false
# PAZ_MAIL_FROM=PAZOS <no-reply@localhost>
