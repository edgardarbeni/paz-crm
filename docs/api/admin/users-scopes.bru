meta {
  name: Asignar alcance geográfico
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/users/{{userId}}/scopes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "scopes": [
      { "level": "municipality", "node_id": "{{nodeId}}" }
    ]
  }
}

docs {
  Niveles: national (sin node_id), electoral_region, state, federal_district, local_district,
  municipality, section. No se puede otorgar un alcance más amplio que el propio (D-34).
}
