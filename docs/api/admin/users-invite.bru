meta {
  name: Invitar usuario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "capturista@example.com",
    "full_name": "Capturista Uno",
    "role_ids": []
  }
}

docs {
  Crea el usuario en estado `invited` y envía el correo (en desarrollo: Mailpit,
  http://localhost:8025). Solo se pueden asignar roles cuyos permisos ya tiene quien invita.
}
