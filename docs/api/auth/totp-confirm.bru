meta {
  name: 3b. Enrolar TOTP (confirmar)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/mfa/totp/confirm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "code": "{{totpCode}}"
  }
}

script:post-response {
  if (res.status === 200) bru.setVar("accessToken", res.body.access_token);
}

docs {
  Devuelve los 10 códigos de recuperación (se muestran una sola vez) y un access token nuevo
  con alcance completo.
}
