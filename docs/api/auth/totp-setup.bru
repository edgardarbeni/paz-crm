meta {
  name: 3a. Enrolar TOTP (inicio)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/mfa/totp/setup
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Devuelve `secret`, `otpauth_uri` y `qr_svg` (data URI) para Google Authenticator,
  Microsoft Authenticator o 1Password. Luego confirmar con 3b.
}
