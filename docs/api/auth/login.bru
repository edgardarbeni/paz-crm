meta {
  name: 1. Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "device_label": "Bruno"
  }
}

script:post-response {
  if (res.body.status === "authenticated") bru.setVar("accessToken", res.body.access_token);
  if (res.body.status === "mfa_required") bru.setVar("mfaToken", res.body.mfa_token);
}

docs {
  Respuestas (200):
  - `{"status": "authenticated", "access_token", "expires_in", "scope"}` + cookie `paz_refresh`.
    `scope = "mfa_enrollment"` si el rol exige 2FA y aún no se enrola TOTP (usar 3a/3b).
  - `{"status": "mfa_required", "mfa_token", "expires_in"}` → usar "2. Verificar TOTP".
  Errores: 401 genérico (no revela si la cuenta existe o está bloqueada), 429 con Retry-After.
}
