meta {
  name: 5. Renovar access token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200) bru.setVar("accessToken", res.body.access_token);
}

docs {
  Usa la cookie `paz_refresh` (Bruno la conserva tras el login) y la rota. Reusar un refresh
  token ya usado cierra la sesión completa (detección de robo).
}
