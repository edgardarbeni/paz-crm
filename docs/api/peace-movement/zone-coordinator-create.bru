meta {
  name: Asignar coordinador de zona
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/peace-movement/zone-coordinators
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "user_id": "{{userId}}",
    "state_id": "{{stateId}}",
    "nodes": [
      {
        "level": "municipality",
        "node_id": "{{municipalityId}}"
      }
    ]
  }
}
