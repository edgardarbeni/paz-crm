meta {
  name: Reasignar crédito
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/peace-movement/houses/{{houseId}}/credit
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "member_id": "{{memberId}}",
    "reason": "Acuerdo de la coordinación estatal"
  }
}

docs {
  A un pacificador activo de cualquier nivel (member_id) o a un asiento ocupado de la estructura
  del partido (position_id), con motivo (D-103).
}
